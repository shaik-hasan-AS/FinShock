# AWS Credentials & Region (Optional - FinShock defaults to local fallback without them)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=ap-south-1

# Service Names (Configured for 100% Free Tier in template.yaml)
FINSHOCK_DYNAMODB_TABLE=finshock_experiments
FINSHOCK_S3_BUCKET=finshock-reports
FINSHOCK_SNS_TOPIC=finshock-risk-alerts
FINSHOCK_SQS_QUEUE=finshock-simulation-queue
FINSHOCK_SSM_PARAM_NAME=/finshock/config/risk_free_rate
